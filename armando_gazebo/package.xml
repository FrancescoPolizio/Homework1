<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>armando_gazebo</name>
  <version>0.0.0</version>
  <description>A package to spawn the robot in the gazebo environment as well as to simulate the motion and control</description>
  <maintainer email="f.polizio@studenti.unina.it">user</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <exec_depend>armando_description</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>     
  <exec_depend>urdf_launch</exec_depend>    

  <depend>controller_manager</depend>
  <depend>ros2_controllers</depend>
  <depend>ros2_control</depend>
  <depend>gz_ros2_control</depend>  

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>